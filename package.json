{
  "name": "oi-tesla",
  "version": "0.1.0",
  "private": true,
  "description": "Oi Tesla — EV ride-pooling service for Dhaka commuters",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "test": "npm run test --workspace=backend --if-present",
    "lint": "npm run lint --workspace=frontend --if-present"
  },
  "keywords": [
    "oi-tesla",
    "ride-pooling",
    "express",
    "nextjs",
    "postgresql"
  ],
  "author": "",
  "license": "ISC"
}
